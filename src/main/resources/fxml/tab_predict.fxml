<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns="http://javafx.com/javafx/11" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.medical.ml.ui.controller.PredictTabController"
      spacing="15" style="-fx-padding: 20;">

    <Label text="Prediction Engine" style="-fx-font-size: 24px; -fx-font-weight: bold;"/>
    
    <!-- Model Section -->
    <VBox spacing="10" style="-fx-padding: 15; -fx-border-color: #cccccc; -fx-border-radius: 5; -fx-background-color: #f9f9f9;">
        <Label text="Step 1: Select Active Model" style="-fx-font-size: 16px; -fx-font-weight: bold;"/>
        <HBox spacing="10" alignment="CENTER_LEFT">
            <ComboBox fx:id="comboHistory" promptText="Switch model from training history..."/>
            <Region HBox.hgrow="ALWAYS" />
            <Button text="Load local model (.zip)..." onAction="#handleLoadModel" style="-fx-base: #e1f5fe;"/>
            <Button text="📊 Open Multi-Model Comparison Panel" onAction="#handleCompareModels" style="-fx-base: #fff9c4;"/>
        </HBox>
        <HBox spacing="10" alignment="CENTER_LEFT">
            <Label text="Current Model: " style="-fx-font-weight: bold;"/>
            <Label fx:id="lblCurrentModel" text="No model loaded yet." textFill="#d32f2f"/>
        </HBox>
    </VBox>

    <Separator/>

    <!-- Prediction Section -->
    <VBox spacing="20" style="-fx-padding: 15; -fx-border-color: #cccccc; -fx-border-radius: 5; -fx-background-color: #ffffff;" VBox.vgrow="ALWAYS">
        <Label text="Step 2: Patient Prediction" style="-fx-font-size: 16px; -fx-font-weight: bold;"/>
        
        <HBox spacing="20">
            <!-- Single Patient Predict -->
            <VBox spacing="10" alignment="TOP_CENTER" style="-fx-padding: 20; -fx-border-color: #dddddd; -fx-border-radius: 5;" HBox.hgrow="ALWAYS">
                <Label text="Real-time Single Patient Diagnosis" style="-fx-font-size: 14px; -fx-font-weight: bold;"/>
                <Label text="Manually enter feature data for one patient" textFill="#666666"/>
                <Button text="Open Dynamic Evaluation Form" onAction="#handleSinglePredict" prefWidth="220" prefHeight="40" style="-fx-base: #4caf50; -fx-font-weight: bold;"/>
            </VBox>

            <!-- Batch Predict -->
            <VBox spacing="10" alignment="TOP_CENTER" style="-fx-padding: 20; -fx-border-color: #dddddd; -fx-border-radius: 5;" HBox.hgrow="ALWAYS">
                <Label text="Batch Prediction (CSV Import)" style="-fx-font-size: 14px; -fx-font-weight: bold;"/>
                <Label text="Upload complete CSV for multiple patients" textFill="#666666"/>
                <Button text="Upload CSV and Predict" onAction="#handleBatchPredict" prefWidth="220" prefHeight="40" style="-fx-base: #2196f3; -fx-font-weight: bold;"/>
            </VBox>
        </HBox>
    </VBox>

</VBox>
