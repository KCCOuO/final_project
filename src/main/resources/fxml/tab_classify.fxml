<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns="http://javafx.com/javafx/11" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.medical.ml.ui.controller.ClassifyTabController"
      spacing="8" style="-fx-padding: 10;">

    <HBox spacing="10" alignment="CENTER_LEFT" style="-fx-border-color: #ccc; -fx-padding: 8;">
        <Label text="Classifier" style="-fx-font-weight: bold;"/>
        <Button text="Choose" onAction="#handleChooseClassifier" prefWidth="80"/>
        <TextField fx:id="txtCurrentClassifier" text="trees.J48" editable="false" HBox.hgrow="ALWAYS" style="-fx-background-color: #fff; -fx-border-color: #ccc;"/>
    </HBox>

    <SplitPane VBox.vgrow="ALWAYS" dividerPositions="0.3">
        <!-- Left Panel -->
        <VBox spacing="10" style="-fx-padding: 5;">
            
            <!-- Test Options -->
            <VBox style="-fx-border-color: #ccc; -fx-padding: 25 5 5 5;" spacing="5">
                <Label text="Test options" style="-fx-translate-y: -22; -fx-background-color: #f4f4f4; -fx-padding: 0 5;"/>
                <VBox spacing="8" style="-fx-translate-y: -15;">
                    <fx:define><ToggleGroup fx:id="tgTestOptions"/></fx:define>
                    
                    <HBox spacing="5" alignment="CENTER_LEFT" visible="false" managed="false">
                        <RadioButton fx:id="rbSuppliedTest" text="Supplied test set" toggleGroup="$tgTestOptions"/>
                        <Button text="Set..." disable="true" style="-fx-font-size: 10px;"/>
                    </HBox>
                    
                    <HBox spacing="5" alignment="CENTER_LEFT">
                        <RadioButton fx:id="rbCrossValidation" text="Cross-validation" toggleGroup="$tgTestOptions"/>
                        <Label text="Folds"/>
                        <TextField fx:id="txtFolds" text="10" prefWidth="40"/>
                    </HBox>
                    
                    <HBox spacing="5" alignment="CENTER_LEFT">
                        <RadioButton fx:id="rbPercentageSplit" text="Percentage split" toggleGroup="$tgTestOptions" selected="true"/>
                        <Label text="\%"/>
                        <TextField fx:id="txtSplitRatio" text="80" prefWidth="40"/>
                    </HBox>

                    <Button text="More options..." disable="true" maxWidth="Infinity"/>
                </VBox>
            </VBox>

            <!-- Target Selection & Buttons -->
            <VBox spacing="10" style="-fx-padding: 5 0;">
                <ComboBox fx:id="comboTargetClass" maxWidth="Infinity" promptText="Target Class"/>
                
                <HBox spacing="10" alignment="CENTER">
                    <Button fx:id="btnStart" text="Start" onAction="#handleStartClassification" prefWidth="80"/>
                    <Button fx:id="btnStop" text="Stop" onAction="#handleStopClassification" disable="true" prefWidth="80"/>
                </HBox>
            </VBox>

            <!-- Result List -->
            <VBox style="-fx-border-color: #ccc; -fx-padding: 25 5 5 5;" VBox.vgrow="ALWAYS">
                <Label text="Result list" style="-fx-translate-y: -22; -fx-background-color: #f4f4f4; -fx-padding: 0 5;"/>
                <ListView fx:id="lvResultList" VBox.vgrow="ALWAYS" style="-fx-translate-y: -10;"/>
                <HBox spacing="10" alignment="CENTER" style="-fx-translate-y: -5;">
                    <Button text="Save selected model..." onAction="#handleExportModel" style="-fx-base: #fff9c4;" prefWidth="160"/>
                </HBox>
            </VBox>

        </VBox>

        <!-- Right Panel - Classifier Output -->
        <VBox style="-fx-padding: 5;">
            <VBox style="-fx-border-color: #ccc; -fx-padding: 25 5 5 5;" VBox.vgrow="ALWAYS">
                <Label text="Classifier output" style="-fx-translate-y: -22; -fx-background-color: #f4f4f4; -fx-padding: 0 5;"/>
                <TextArea fx:id="txtClassifierOutput" VBox.vgrow="ALWAYS" editable="false" 
                          style="-fx-translate-y: -10; -fx-font-family: 'Consolas', 'Courier New', monospace; -fx-font-size: 12px; -fx-background-color: #fff;"/>
            </VBox>
        </VBox>
    </SplitPane>
</VBox>
