<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.chart.*?>

<VBox xmlns="http://javafx.com/javafx/11" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.medical.ml.ui.controller.PreprocessTabController"
      spacing="8" style="-fx-padding: 10;">

    <HBox spacing="10" alignment="CENTER_LEFT">
        <Button text="Open Dataset (CSV)..." onAction="#handleOpenFile" prefWidth="150" style="-fx-font-weight: bold;"/>
        <Region HBox.hgrow="ALWAYS" />
        <!-- <Button text="Save Merged Data..." onAction="#handleSaveCSV" prefWidth="150" style="-fx-base: #e1f5fe;"/> -->
    </HBox>

    <SplitPane VBox.vgrow="ALWAYS" dividerPositions="0.4">
        <!-- Left Panel -->
        <VBox spacing="10" style="-fx-padding: 5;">
            <!-- Current Relation -->
            <VBox spacing="5" style="-fx-border-color: #ccc; -fx-padding: 25 5 5 5;">
                <Label text="Current Dataset" style="-fx-translate-y: -22; -fx-background-color: #f4f4f4; -fx-padding: 0 5;"/>
                <VBox spacing="5" style="-fx-translate-y: -15; -fx-padding: 0 5;">
                    <Label text="Relation:"/>
                    <TextArea fx:id="txtRelationName" text="None" editable="false" wrapText="true" prefHeight="60" style="-fx-control-inner-background: #fcfcfc;"/>
                    <HBox spacing="20">
                        <HBox spacing="5"><Label text="Instances:"/><Label fx:id="lblInstancesCount" text="0" style="-fx-font-weight: bold;"/></HBox>
                        <HBox spacing="5"><Label text="Attributes:"/><Label fx:id="lblAttributesCount" text="0" style="-fx-font-weight: bold;"/></HBox>
                    </HBox>
                </VBox>
            </VBox>
            
            <!-- Attributes List -->
            <VBox style="-fx-border-color: #ccc; -fx-padding: 25 5 5 5;" VBox.vgrow="ALWAYS">
                <Label text="Attributes List" style="-fx-translate-y: -22; -fx-background-color: #f4f4f4; -fx-padding: 0 5;"/>
                <TableView fx:id="tblAttributes" VBox.vgrow="ALWAYS" style="-fx-translate-y: -10;">
                    <columns>
                        <TableColumn fx:id="colAttrCheck" prefWidth="30" sortable="false"/>
                        <TableColumn fx:id="colAttrNo" text="No." prefWidth="40"/>
                        <TableColumn fx:id="colAttrName" text="Name" prefWidth="250"/>
                    </columns>
                </TableView>
                <HBox spacing="5" alignment="CENTER" style="-fx-padding: 0 0 5 0; -fx-translate-y: -10;">
                    <Button text="All" onAction="#handleSelectAllAttr" prefWidth="60"/>
                    <Button text="None" onAction="#handleSelectNoneAttr" prefWidth="60"/>
                    <Button text="Invert" onAction="#handleInvertAttrSelection" prefWidth="60"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button text="Remove Selected" onAction="#handleRemoveSelectedAttr" prefWidth="120"/>
                </HBox>
            </VBox>
        </VBox>

        <!-- Right Panel -->
        <VBox spacing="5" style="-fx-padding: 5;">
            <SplitPane orientation="VERTICAL" VBox.vgrow="ALWAYS" dividerPositions="0.4">
                <!-- Selected Attribute -->
                <VBox style="-fx-border-color: #ccc; -fx-padding: 25 5 5 5;">
                    <Label text="Selected Attribute Details" style="-fx-translate-y: -22; -fx-background-color: #f4f4f4; -fx-padding: 0 5;"/>
                    <GridPane hgap="10" vgap="5" style="-fx-translate-y: -15;">
                        <Label text="Name:" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                        <Label fx:id="lblSelectedAttrName" text="None" wrapText="true" minHeight="-Infinity" GridPane.columnIndex="1" GridPane.rowIndex="0" style="-fx-font-weight: bold;"/>
                        <Label text="Type:" GridPane.columnIndex="2" GridPane.rowIndex="0"/>
                        <Label fx:id="lblSelectedAttrType" text="None" GridPane.columnIndex="3" GridPane.rowIndex="0"/>
                        
                        <Label text="Missing:" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                        <Label fx:id="lblSelectedAttrMissing" text="0 (0%)" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
                        <Label text="Distinct:" GridPane.columnIndex="2" GridPane.rowIndex="1"/>
                        <Label fx:id="lblSelectedAttrDistinct" text="0" GridPane.columnIndex="3" GridPane.rowIndex="1"/>
                        <Label text="Unique:" GridPane.columnIndex="4" GridPane.rowIndex="1"/>
                        <Label fx:id="lblSelectedAttrUnique" text="0 (0%)" GridPane.columnIndex="5" GridPane.rowIndex="1"/>
                    </GridPane>
                    <TableView fx:id="tblStats" VBox.vgrow="ALWAYS" prefHeight="130" style="-fx-translate-y: -10;">
                        <columns>
                            <TableColumn fx:id="colStatsNo" text="No." prefWidth="40"/>
                            <TableColumn fx:id="colStatsLabel" text="Label" prefWidth="120"/>
                            <TableColumn fx:id="colStatsCount" text="Count / Value" prefWidth="150"/>
                            <TableColumn fx:id="colStatsWeight" text="Weight" prefWidth="100"/>
                        </columns>
                    </TableView>
                </VBox>
                
                <VBox style="-fx-border-color: #ccc; -fx-padding: 5;" VBox.vgrow="ALWAYS">
                    <StackPane VBox.vgrow="ALWAYS">
                        <BarChart fx:id="chartHistogram" legendVisible="false" animated="false" title="Histogram">
                            <xAxis><CategoryAxis fx:id="xAxis" /></xAxis>
                            <yAxis><NumberAxis fx:id="yAxis" /></yAxis>
                        </BarChart>
                        <Label fx:id="lblHistogramNotSupported" text="不支援此資料類型的 Histogram" visible="false" style="-fx-font-size: 14px; -fx-text-fill: gray;"/>
                    </StackPane>
                </VBox>
            </SplitPane>
        </VBox>
    </SplitPane>
</VBox>
